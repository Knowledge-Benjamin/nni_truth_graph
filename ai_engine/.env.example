# AI Engine Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=production

# Execution Mode: cloud | local
EXECUTION_MODE=cloud
# Use local self-hosted Gemma via Ollama when EXECUTION_MODE=local.
# Ensure OLLAMA_BASE_URL points to your Ollama endpoint and set OLLAMA_SENTINEL.
OLLAMA_SENTINEL=ollama

# PostgreSQL Database Connection (Required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Neo4j Graph Database (Required)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Groq API Keys (all keys serve any tier — just add more for higher throughput)
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# HuggingFace Tokens — embedding pool (round-robin across all populated slots)
HF_TOKEN=hf_...
HF_TOKEN_2=
HF_TOKEN_3=
HF_TOKEN_4=
HF_TOKEN_5=
HF_TOKEN_6=
HF_TOKEN_7=
HF_TOKEN_8=

# Google APIs (GOOGLE_API_KEY and GEMINI_API_KEY are both loaded automatically)
GOOGLE_API_KEY=your-google-ai-studio-key
GOOGLE_API_KEY_2=
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_FACT_CHECK_KEY=your-google-fact-check-key

# Serper (Google Search proxy)
SERPER_API_KEY=your-serper-api-key

# ── Router Failover Keys (Optional but Recommended) ────────────────────────────
# Any key here is used for any tier — no segmentation
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_2=
GITHUB_API_KEY=ghp_...
GITHUB_API_KEY_2=

# ── Microservice URLs (Hugging Face Spaces) ────────────────────────────────────
INFERENCE_SERVER_URL=https://inference-server-qvem3ril2q-uc.a.run.app
INFERENCE_API_KEY=your_inference_api_key

VISION_INFERENCE_URL=https://vision-server-qvem3ril2q-uc.a.run.app
VISION_API_KEY=your_vision_api_key

SEARXNG_URL=https://search-server-qvem3ril2q-uc.a.run.app
SEARCH_API_KEY=your_searxng_api_key

# AI Engine HTTP Port
PORT=8001

# OSINT API Keys (Placeholders)
SHODAN_API_KEY=""
HIBP_API_KEY=""
VIRUSTOTAL_API_KEY=""
OPENCORPORATES_API_KEY=""
ETHERSCAN_API_KEY=""
SEC_EDGAR_USER_AGENT="John Doe john.doe@example.com"

# ── Licensing Configuration ──
# ENVIRONMENT should be 'prod' to enforce credit checking, 'dev' to bypass
ENVIRONMENT=prod
LICENSE_PUB_KEY="-----BEGIN PUBLIC KEY-----\n..."
LICENSE_SERVER_URL=https://license.example.com
