# AI Engine Environment Variables
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=production

# Execution Mode: cloud | local
EXECUTION_MODE=cloud

# PostgreSQL Database Connection (Required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Neo4j Graph Database (Required)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Groq API Keys — 8B pool (round-robin across all populated slots)
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Groq API Keys — 70B pool (round-robin across all populated slots)
GROQ_API_KEY_70B=gsk_...
GROQ_API_KEY_70B_2=
GROQ_API_KEY_70B_3=
GROQ_API_KEY_70B_4=
GROQ_API_KEY_70B_5=

# HuggingFace Tokens — embedding pool (round-robin across all populated slots)
HF_TOKEN=hf_...
HF_TOKEN_2=
HF_TOKEN_3=
HF_TOKEN_4=
HF_TOKEN_5=
HF_TOKEN_6=
HF_TOKEN_7=
HF_TOKEN_8=

# Google APIs
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_FACT_CHECK_KEY=your-google-fact-check-key

# Serper (Google Search proxy)
SERPER_API_KEY=your-serper-api-key

# ── Microservice URLs (Hugging Face Spaces) ────────────────────────────────────
INFERENCE_SERVER_URL=https://inference-server-qvem3ril2q-uc.a.run.app
INFERENCE_API_KEY=your_inference_api_key

VISION_INFERENCE_URL=https://vision-server-qvem3ril2q-uc.a.run.app
VISION_API_KEY=your_vision_api_key

SEARXNG_URL=https://search-server-qvem3ril2q-uc.a.run.app
SEARCH_API_KEY=your_searxng_api_key

# AI Engine HTTP Port
PORT=8001
