# Server Environment Variables
# Copy this file to .env and fill in your actual values

# PostgreSQL Database Connection (Required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neo4j Graph Database (Required)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Server Port (Default: 4000)
PORT=5000

# CORS — comma-separated list of allowed origins
# In production, set this to your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:3000

# Groq API Key (used for Natural Language Graph Search)
GROQ_API_KEY=gsk_...
